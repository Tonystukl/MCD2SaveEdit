<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MCD2SaveEdit</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>Data\App\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" />
    <EmbeddedResource Include="Data\Icons\*.png" />
    <EmbeddedResource Include="Data\App\app.ico" />
    <EmbeddedResource Include="Data\Maps\*.png" />
  </ItemGroup>
</Project>
